---
import Base from '../layouts/Base.astro';
import { site, areas } from '../data/site';
---
<Base title="Kontakt" description="Boka en genomgång med Online Innovation om hotell, e-handel eller automation.">
  <section class="bg-mist">
    <div class="wrap py-16 md:py-20">
      <h1 class="max-w-[16ch]">Boka en genomgång</h1>
      <p class="lede mt-6">
        Berätta kort om verksamheten och vad ni vill förbättra. Vi hör av oss inom en arbetsdag
        och föreslår en tid.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-14 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <div id="form-status" role="status" class="mb-6 hidden rounded-lg px-5 py-4 font-medium"></div>

        <form action="/kontakt.php" method="post" class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-1.5 sm:col-span-2">
            <span class="font-medium">Vad gäller det?</span>
            <select name="omrade" id="omrade" class="field">
              {areas.map((a) => <option value={a.key}>{a.label}: {a.door.toLowerCase()}</option>)}
              <option value="annat">Något annat</option>
            </select>
          </label>
          <label class="grid gap-1.5">
            <span class="font-medium">Namn</span>
            <input name="namn" required autocomplete="name" class="field" />
          </label>
          <label class="grid gap-1.5">
            <span class="font-medium">Företag</span>
            <input name="foretag" autocomplete="organization" class="field" />
          </label>
          <label class="grid gap-1.5">
            <span class="font-medium">E-post</span>
            <input name="epost" type="email" required autocomplete="email" class="field" />
          </label>
          <label class="grid gap-1.5">
            <span class="font-medium">Telefon <span class="font-normal text-ink-soft">(valfritt)</span></span>
            <input name="telefon" type="tel" autocomplete="tel" class="field" />
          </label>
          <label class="grid gap-1.5 sm:col-span-2">
            <span class="font-medium">Meddelande</span>
            <textarea id="meddelande" name="meddelande" rows="6" required class="field"></textarea>
          </label>
          <!-- Fälla för spambottar, ska lämnas tom -->
          <label class="hidden" aria-hidden="true">Webbplats <input name="webbplats" tabindex="-1" autocomplete="off" /></label>
          <div class="sm:col-span-2">
            <button type="submit" class="btn btn-sun">Skicka förfrågan</button>
            <p class="mt-3 text-sm text-ink-soft">Vi använder uppgifterna bara för att svara dig. Läs mer i vår <a class="underline" href="/integritetspolicy/">integritetspolicy</a>.</p>
          </div>
        </form>
      </div>

      <aside class="self-start rounded-xl bg-mist p-7">
        <h2 class="text-2xl">Hellre mejl?</h2>
        <p class="mt-3"><a class="font-medium underline decoration-sun-deep decoration-2 underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="mt-2 text-ink-soft">{site.hours}</p>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      var p = new URLSearchParams(location.search);
      var hints = {
        hotell: 'T.ex. ungefär hur många konferenser ni har per år, var förfrågningarna kommer ifrån och vilket bokningssystem ni använder.',
        ehandel: 'T.ex. hur många nya produkter ni lägger upp per månad, i vilket format leverantörerna skickar filer och vilka marknader ni säljer på.',
        automation: 'T.ex. vilka system ni använder och vilket manuellt arbete som tar mest tid.',
        annat: 'Berätta kort vad ni vill ha hjälp med.'
      };
      var sel = document.getElementById('omrade');
      var msg = document.getElementById('meddelande');
      var wanted = p.get('omrade');
      if (sel && wanted && hints[wanted]) sel.value = wanted;
      var setHint = function () { if (msg && sel) msg.placeholder = hints[sel.value] || hints.annat; };
      if (sel) sel.addEventListener('change', setHint);
      setHint();

      var box = document.getElementById('form-status');
      if (!box) return;
      if (p.get('skickat') === 'ja') {
        box.textContent = 'Tack! Förfrågan är skickad. Vi hör av oss inom en arbetsdag.';
        box.className = 'mb-6 rounded-lg px-5 py-4 font-medium bg-[#e3f1ea] text-[#1f5c43]';
      } else if (p.get('fel')) {
        box.textContent = 'Förfrågan kunde inte skickas. Kontrollera att namn, e-post och meddelande är ifyllda, eller mejla oss direkt.';
        box.className = 'mb-6 rounded-lg px-5 py-4 font-medium bg-[#f8e3dd] text-[#8a2f1d]';
      }
    })();
  </script>
</Base>
