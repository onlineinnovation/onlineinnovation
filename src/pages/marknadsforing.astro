---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const parts = [
  { title: 'Google Ads', text: 'Kampanjer för rum, konferens, bord och evenemang, var för sig. Budgeten styrs mot det som ger bokningar, inte klick.' },
  { title: 'Sökoptimering', text: 'Teknisk SEO, innehåll och lokal synlighet, så att gäster som söker på er ort hittar er före bokningssajterna.' },
  { title: 'Landningssidor', text: 'Sidor byggda för en annons och ett erbjudande, med ett tydligt nästa steg. För Ekenäs gör vi separata sidor för hotell, konferens och restaurang.' },
  { title: 'Mätning till kronor', text: 'Annonser och bokningar kopplas ihop med kassa och bokningssystem. Ni ser intäkten per kampanj i samma dashboard som resten av verksamheten.' },
];
---
<Base title="Marknadsföring" description="Google Ads, sökoptimering och landningssidor för hotell och restauranger, mätt i intäkt.">
  <section class="on-dark bg-forest text-white">
    <div class="wrap py-16 md:py-24">
      <h1 class="max-w-[18ch]">Marknadsföring som går att följa till kassan</h1>
      <p class="lede mt-6 !text-white/80">
        Vi har gjort digital marknadsföring sedan 2014. Nu kopplar vi den till samma data som resten
        av verksamheten, så att ni ser vad annonserna ger i intäkt och inte bara i klick.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-x-12 gap-y-12 md:grid-cols-2">
      {parts.map((p) => (
        <div class="border-l-4 border-sun pl-5">
          <h2 class="text-2xl md:text-3xl">{p.title}</h2>
          <p class="mt-3 text-ink-soft measure">{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-mist py-16">
    <div class="wrap max-w-3xl">
      <h2>Pris</h2>
      <p class="mt-4 text-lg">
        Marknadsföring sätts upp som ett löpande uppdrag med fast månadsavgift, plus annonsbudget som
        går direkt till Google eller Meta. Vi lämnar förslag efter ett första samtal.
      </p>
    </div>
  </section>

  <CtaBand title="Vill ni ha fler bokningar?" text="Berätta vad ni vill fylla, rum, konferenser eller bord, så tittar vi på hur ni syns idag och vad som går att göra." />
</Base>
