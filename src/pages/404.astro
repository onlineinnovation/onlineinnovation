---
import Base from '../layouts/Base.astro';
---
<Base title="Sidan finns inte">
  <section class="py-24 md:py-32">
    <div class="wrap max-w-2xl">
      <h1>Sidan finns inte här längre</h1>
      <p class="lede mt-6">Webbplatsen är ny och en del adresser har ändrats. Börja från startsidan eller hör av dig direkt.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-sun">Till startsidan</a>
        <a href="/kontakt/" class="btn btn-ghost">Kontakta oss</a>
      </div>
    </div>
  </section>
</Base>
