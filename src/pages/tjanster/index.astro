---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/site';
---
<Base title="Tjänster" description="Automation, live-dashboards och extern teknikchef för hotell och restauranger.">
  <section class="on-dark bg-forest text-white">
    <div class="wrap py-16 md:py-24">
      <h1 class="max-w-[16ch]">Tre moduler, valda efter var det kostar mest</h1>
      <p class="lede mt-6 !text-white/80">
        Börja med den som löser ert största problem. De bygger på varandra: automationen ger datan,
        dashboarden visar den, och som teknikchef håller vi ihop helheten.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap divide-y divide-line border-y border-line">
      {services.map((s) => (
        <article class="grid gap-6 py-12 md:grid-cols-[1.4fr_1fr] md:gap-14">
          <div>
            <h2 class="text-3xl md:text-4xl">{s.name}</h2>
            <p class="mt-4 text-lg">{s.short}</p>
            <p class="mt-3 text-ink-soft measure">{s.problem}</p>
          </div>
          <div class="md:pt-2">
            <p class="font-display text-2xl font-bold">{s.price}</p>
            <p class="mt-2 text-ink-soft">{s.priceNote}</p>
            <a href={s.href} class="btn btn-ghost mt-6">Läs om {s.name}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-mist py-14">
    <div class="wrap flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <p class="text-lg max-w-[60ch]">Behöver ni fler gäster snarare än bättre system? Vi gör fortfarande Google Ads, sökoptimering och landningssidor.</p>
      <a href="/marknadsforing/" class="btn btn-ghost">Om marknadsföringen</a>
    </div>
  </section>

  <CtaBand />
</Base>
