---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { cases } from '../data/site';
---
<Base title="Case" description="Kunder inom hotell, restaurang, event och e-handel som Online Innovation arbetar med.">
  <section class="on-dark bg-forest text-white">
    <div class="wrap py-16 md:py-24">
      <h1 class="max-w-[16ch]">Kunder vi jobbar med</h1>
      <p class="lede mt-6 !text-white/80">
        Hotell, konferens och restaurang först. Längre ner några av e-handels- och tjänsteföretagen
        vi har byggt och marknadsfört åt genom åren.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap divide-y divide-line border-y border-line">
      {cases.map((c) => (
        <article class="grid gap-4 py-10 md:grid-cols-[1fr_1.6fr] md:gap-14">
          <div>
            <p class="text-sm text-ink-soft">{c.sector}</p>
            <h2 class="mt-1 text-2xl md:text-3xl">{c.name}</h2>
          </div>
          <div>
            <p class="text-lg measure">{c.summary}</p>
            <p class="mt-3 text-forest">{c.work.join(', ')}</p>
            {c.url && (
              <a href={c.url} rel="noopener" class="mt-4 inline-block font-medium underline decoration-sun decoration-2 underline-offset-4">
                Besök {new URL(c.url).hostname.replace('www.', '')}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>
