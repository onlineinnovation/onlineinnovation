---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, areas, method } from '../data/site';

const values = [
  { title: 'Byggt på det ni har', text: 'Inga nya system att lära sig. Vi kopplar ihop de befintliga.' },
  { title: 'Fast pris', text: 'Ni vet kostnaden innan vi börjar, och varje område har en garanti.' },
  { title: 'Mätt i kronor och timmar', text: 'Varje lösning har ett mål som går att följa upp.' },
];
---
<Base>
  <!-- Hero med de tre dörrarna -->
  <section class="pb-16 pt-14 md:pb-24 md:pt-20">
    <div class="wrap">
      <h1 class="max-w-[14ch]">{site.tagline}</h1>
      <p class="lede mt-6">{site.description}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#omraden" class="btn btn-sun">Välj ditt område</a>
        <a href="/kontakt/" class="btn btn-ghost">Boka en genomgång</a>
      </div>

      <div id="omraden" class="mt-14 grid scroll-mt-24 gap-4 md:grid-cols-3">
        {areas.map((a) => (
          <a href={a.href} data-area={a.key} class="group flex flex-col overflow-hidden rounded-2xl area-soft ring-1 ring-ink/5 transition-shadow hover:shadow-lg focus-visible:shadow-lg">
            <div class="h-2 area-bg"></div>
            <div class="flex flex-1 flex-col p-7">
              <p class="font-semibold area-text">{a.label}</p>
              <h2 class="mt-3 text-[1.7rem] md:text-[1.9rem]">{a.door}</h2>
              <p class="mt-3 text-ink-soft">{a.doorText}</p>
              <p class="mt-auto pt-8 text-sm text-ink-soft">{a.who}</p>
              <span class="mt-3 font-semibold underline decoration-2 underline-offset-4 [text-decoration-color:var(--area)] group-hover:no-underline">Till {a.label.toLowerCase()}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Värdelöften -->
  <section class="border-t border-line py-16 md:py-20">
    <div class="wrap grid gap-10 md:grid-cols-3">
      {values.map((v) => (
        <div>
          <h3>{v.title}</h3>
          <p class="mt-2 text-ink-soft">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Så arbetar vi (verklig ordningsföljd) -->
  <section class="bg-mist py-20 md:py-28">
    <div class="wrap">
      <h2>Så arbetar vi, oavsett område</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-3">
        {method.map((m, i) => (
          <li class="border-t-4 border-sun-deep pt-5">
            <span class="font-display text-5xl font-bold">{i + 1}</span>
            <h3 class="mt-3">{m.name}</h3>
            <p class="mt-2 text-ink-soft">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>
