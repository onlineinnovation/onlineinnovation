---
import Base from '../layouts/Base.astro';
import DayReport from '../components/DayReport.astro';
import CtaBand from '../components/CtaBand.astro';
import { steps, conferenceTypes } from '../data/site';

const leaks = [
  {
    problem: 'Svaret dröjer',
    text: 'Den som planerar en konferens frågar ofta flera hotell samtidigt. Kommer ert svar dagen efter har beslutet redan börjat lutas åt någon annan.',
    fix: 'Beställaren får bekräftelse och prisindikation direkt, och säljaren ett färdigt underlag.',
  },
  {
    problem: 'Offerten glöms bort',
    text: 'Offerten är skickad, kunden svarar inte, och i högsäsong hinner ingen ringa upp. Förfrågan rinner ut i sanden.',
    fix: 'Uppföljningen går av sig själv tills kunden har svarat ja eller nej.',
  },
  {
    problem: 'Annonserna mäts i klick',
    text: 'Annonsbudgeten syns på fakturan, men ingen kan säga hur många konferenser den gav.',
    fix: 'Varje bokning spåras tillbaka till annonsen och konferenstypen den kom från.',
  },
];
---
<Base>
  <!-- Hero -->
  <section class="on-dark relative overflow-hidden bg-forest text-white">
    <div class="wrap grid items-center gap-14 py-16 md:py-24 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="font-medium text-sun">Konferensförsäljning för hotell</p>
        <h1 class="mt-5">Fler konferenser. Varje förfrågan besvarad samma timme.</h1>
        <p class="lede mt-6 !text-white/80">
          Ett system som når företag när de planerar konferens, svarar på förfrågan direkt och följer
          upp offerten tills den är bokad. Ni ser varje vecka vad marknadsföringen gav i konferensintäkt.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/kontakt/" class="btn btn-sun">Boka en genomgång</a>
          <a href="/sa-fungerar-det/" class="btn btn-ghost text-white">Så fungerar det</a>
        </div>
      </div>
      <DayReport />
    </div>
  </section>

  <!-- Var bokningarna går förlorade -->
  <section class="py-20 md:py-28">
    <div class="wrap">
      <h2 class="max-w-[20ch]">Här går konferensbokningar förlorade</h2>
      <div class="mt-12 divide-y divide-line border-y border-line">
        {leaks.map((l) => (
          <div class="grid gap-4 py-10 md:grid-cols-[0.9fr_1.3fr_1.1fr] md:gap-12">
            <h3 class="text-2xl">{l.problem}</h3>
            <p class="text-ink-soft">{l.text}</p>
            <p class="border-l-4 border-sun pl-4 font-medium">{l.fix}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Flödet -->
  <section class="on-dark bg-forest-deep py-20 text-white md:py-28">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="max-w-[18ch]">Från sökning till bokad konferens</h2>
        <a href="/sa-fungerar-det/" class="btn btn-ghost text-white">Se hela flödet</a>
      </div>
      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
        {steps.map((s, i) => (
          <li class="border-t-4 border-sun pt-5">
            <span class="font-display text-4xl font-bold text-sun">{i + 1}</span>
            <h3 class="mt-3 text-white">{s.name}</h3>
            <p class="mt-2 text-white/75">{s.short}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Konferenstyper -->
  <section class="py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <h2>En konferens är inte en konferens</h2>
        <p class="mt-5 text-ink-soft measure">
          En assistent som letar dagkonferens till på torsdag söker annorlunda än en vd som planerar
          ledningsgruppens internat. Därför får varje typ egna annonser, egna sidor och egna frågor
          i förfrågan.
        </p>
      </div>
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {conferenceTypes.map((t) => (
          <div>
            <dt class="font-display text-xl font-semibold">{t.name}</dt>
            <dd class="mt-2 text-ink-soft">{t.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Ni behåller era system -->
  <section class="bg-mist py-20 md:py-24">
    <div class="wrap grid gap-10 md:grid-cols-2 md:items-center">
      <h2 class="max-w-[16ch]">Ni behåller era system</h2>
      <p class="text-lg measure">
        Bokningssystem, mejl och kalender fortsätter som vanligt. Vi bygger kopplingarna runt dem,
        så att förfrågningar, offerter och uppföljning hamnar där säljaren redan jobbar. Inget nytt
        program för personalen att lära sig.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>
