---
interface Props { title?: string; text?: string }
const {
  title = 'Boka en genomgång av er konferensförsäljning',
  text = 'Trettio minuter. Vi går igenom var era konferensförfrågningar kommer ifrån, hur snabbt de besvaras och vad som händer med offerterna. Ni får en kort skiss på vad som går att förbättra, oavsett om vi jobbar ihop sedan eller inte.',
} = Astro.props;
---
<section class="bg-sun">
  <div class="wrap grid items-end gap-8 py-16 md:grid-cols-[1.5fr_auto] md:py-20">
    <div>
      <h2>{title}</h2>
      <p class="mt-4 max-w-[58ch] text-lg">{text}</p>
    </div>
    <a href="/kontakt/" class="btn bg-ink text-white hover:bg-forest">Boka en genomgång</a>
  </div>
</section>
