---
import { contactHref, type AreaKey } from '../data/site';
interface Props { title?: string; text?: string; area?: AreaKey }
const {
  title = 'Boka en genomgång',
  text = 'Trettio minuter. Ni får en skiss på vad som går att automatisera, oavsett om vi jobbar ihop sedan eller inte.',
  area,
} = Astro.props;
---
<section class="bg-sun">
  <div class="wrap grid items-end gap-8 py-16 md:grid-cols-[1.5fr_auto] md:py-20">
    <div>
      <h2>{title}</h2>
      <p class="mt-4 max-w-[58ch] text-lg">{text}</p>
    </div>
    <a href={contactHref(area)} class="btn bg-ink text-white hover:bg-graphite">Boka en genomgång</a>
  </div>
</section>
