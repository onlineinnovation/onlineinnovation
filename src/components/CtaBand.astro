---
interface Props { title?: string; text?: string }
const {
  title = 'Börja med ett samtal om era system',
  text = 'Trettio minuter. Vi går igenom vilka system ni har, var det manuella arbetet sitter och vilka siffror ni saknar. Ni får en kort skiss på vad som går att automatisera, oavsett om vi jobbar ihop sedan eller inte.',
} = Astro.props;
---
<section class="bg-sun">
  <div class="wrap grid items-end gap-8 py-16 md:grid-cols-[1.5fr_auto] md:py-20">
    <div>
      <h2>{title}</h2>
      <p class="mt-4 max-w-[58ch] text-lg">{text}</p>
    </div>
    <a href="/kontakt/" class="btn bg-ink text-white hover:bg-forest">Boka ett samtal</a>
  </div>
</section>
