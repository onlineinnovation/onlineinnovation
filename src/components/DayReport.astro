---
// Heroelementet: en veckorapport för konferensförsäljning som "skrivs ut" som ett kvitto
// när sidan laddas. Siffrorna är exempel och märks som det i gränssnittet.
const rows = [
  { label: 'Dagkonferens', count: '9 förfr.', value: '118 800 kr' },
  { label: 'Övernattning', count: '6 förfr.', value: '412 000 kr' },
  { label: 'Ledningsgrupp', count: '3 förfr.', value: '96 500 kr' },
  { label: 'Kick-off', count: '4 förfr.', value: '175 600 kr' },
];
---
<figure class="report relative mx-auto w-full max-w-[23rem]" aria-label="Exempel på en veckorapport för konferensförsäljning">
  <div class="paper relative bg-white px-6 pb-8 pt-6 font-mono text-[0.84rem] text-ink shadow-[0_24px_60px_-20px_rgba(10,30,24,0.55)]">
    <div class="flex items-baseline justify-between border-b border-dashed border-ink/30 pb-3">
      <span class="font-medium">KONFERENSFÖRFRÅGNINGAR</span>
      <span class="text-ink-soft">v. 43</span>
    </div>
    <p class="mt-2 text-ink-soft">Hotell, exempel</p>

    <dl class="mt-4 space-y-2.5">
      {rows.map((r, i) => (
        <div class="row grid grid-cols-[1fr_auto_auto] items-baseline gap-3" style={`--i:${i}`}>
          <dt>{r.label}</dt>
          <dd class="text-ink-soft">{r.count}</dd>
          <dd class="w-[6.5rem] text-right font-medium tabular-nums">{r.value}</dd>
        </div>
      ))}
    </dl>

    <div class="row mt-4 space-y-2 border-t border-dashed border-ink/30 pt-3" style="--i:4">
      <div class="flex justify-between"><span>Offererat värde</span><span class="font-medium tabular-nums">802 900 kr</span></div>
      <div class="flex justify-between"><span>Svarstid, snitt</span><span class="font-medium tabular-nums">11 min</span></div>
    </div>

    <div class="row mt-4 flex items-baseline justify-between border-y-2 border-ink py-2.5 text-[0.95rem]" style="--i:5">
      <span class="font-medium">BOKAT</span>
      <span class="font-medium tabular-nums">7 konferenser · 274 000 kr</span>
    </div>

    <div class="row mt-3 text-[0.76rem] text-ink-soft" style="--i:6">
      4 obesvarade offerter följs upp i morgon kl 09:00
    </div>
  </div>
  <figcaption class="mt-4 text-center text-sm text-white/70">Veckans konferenser, från annons till bokning.</figcaption>
</figure>

<style>
  .paper {
    /* Avriven kvittokant nedtill */
    -webkit-mask: linear-gradient(#000 0 0) top / 100% calc(100% - 8px) no-repeat,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 16px 8px repeat-x;
    mask: linear-gradient(#000 0 0) top / 100% calc(100% - 8px) no-repeat,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 16px 8px repeat-x;
    animation: feed 1.1s cubic-bezier(.2,.7,.2,1) both;
  }
  .row {
    animation: print 0.35s ease-out both;
    animation-delay: calc(0.55s + var(--i) * 0.16s);
  }
  @keyframes feed {
    from { clip-path: inset(0 0 100% 0); transform: translateY(-12px); }
    to { clip-path: inset(0 0 0 0); transform: none; }
  }
  @keyframes print {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
