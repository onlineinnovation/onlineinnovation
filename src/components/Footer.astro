---
import Logo from './Logo.astro';
import { site, areas } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="on-dark bg-graphite text-white/80">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo dark />
      <p class="mt-4 max-w-sm">{site.tagline} Automatiserade system för försäljning och administration.</p>
    </div>
    <div>
      <h2 class="font-sans text-base font-semibold text-white">Områden</h2>
      <ul class="mt-3 space-y-2">
        {areas.map((a) => <li><a class="hover:text-sun" href={a.href}>{a.label}</a></li>)}
        <li><a class="hover:text-sun" href="/om-oss/">Om oss</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-base font-semibold text-white">Kontakt</h2>
      <ul class="mt-3 space-y-2">
        <li><a class="hover:text-sun" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.hours}</li>
        <li class="flex gap-4 pt-1">
          <a class="hover:text-sun" href={site.instagram} rel="noopener">Instagram</a>
          <a class="hover:text-sun" href={site.facebook} rel="noopener">Facebook</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-5 text-sm text-white/60 sm:flex-row sm:justify-between">
      <span>© {year} Online Innovation</span>
      <a class="hover:text-sun" href="/integritetspolicy/">Integritetspolicy</a>
    </div>
  </div>
</footer>
