---
// Ordmärke. Byt gärna mot logofilen (public/images/logo.svg) när den finns.
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5 font-display font-bold text-[1.15rem] tracking-tight', dark ? 'text-white' : 'text-ink']}>
  <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
    <rect width="26" height="26" rx="6" fill="#fdd444" />
    <circle cx="9" cy="13" r="4.2" fill="none" stroke="#1c1f24" stroke-width="2.4" />
    <rect x="16" y="7.5" width="2.6" height="11" rx="1.3" fill="#1c1f24" />
  </svg>
  Online Innovation
</span>
