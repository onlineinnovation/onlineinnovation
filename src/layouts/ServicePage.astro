---
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';

interface Props {
  slug: string;
  headline: string;
  intro: string;
  includes: string[];
  examples: { title: string; text: string }[];
  fitsFor: string;
  faq?: { q: string; a: string }[];
}
const { slug, headline, intro, includes, examples, fitsFor, faq = [] } = Astro.props;
const s = services.find((x) => x.slug === slug)!;
const others = services.filter((x) => x.slug !== slug);
---
<Base title={s.name} description={`${s.short} ${s.priceNote}`}>
  <section class="on-dark bg-forest text-white">
    <div class="wrap py-16 md:py-24">
      <p class="font-medium text-sun"><a href="/tjanster/" class="hover:underline">Tjänster</a> / {s.name}</p>
      <h1 class="mt-5 max-w-[18ch]">{headline}</h1>
      <p class="lede mt-6 !text-white/80">{intro}</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-14 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2>Problemet</h2>
        <p class="mt-4 text-lg measure">{s.problem}</p>

        <h2 class="mt-14">Det här ingår</h2>
        <ul class="mt-6 space-y-3">
          {includes.map((i) => (
            <li class="flex gap-3">
              <svg class="mt-1.5 h-4 w-4 flex-none text-forest" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8.5 6 12l8-8" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
              <span>{i}</span>
            </li>
          ))}
        </ul>
      </div>

      <aside class="self-start rounded-xl border-2 border-ink p-7 lg:sticky lg:top-24">
        <h2 class="font-sans text-base font-semibold">Pris</h2>
        <p class="mt-2 font-display text-3xl font-bold">{s.price}</p>
        <p class="mt-3 text-ink-soft">{s.priceNote}</p>
        <h2 class="mt-7 font-sans text-base font-semibold">Passar för</h2>
        <p class="mt-2 text-ink-soft">{fitsFor}</p>
        <a href="/kontakt/" class="btn btn-sun mt-7 w-full">Boka ett samtal</a>
      </aside>
    </div>
  </section>

  <section class="bg-mist py-16 md:py-24">
    <div class="wrap">
      <h2>Exempel</h2>
      <div class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-2">
        {examples.map((e) => (
          <div class="border-l-4 border-sun pl-5">
            <h3>{e.title}</h3>
            <p class="mt-2 text-ink-soft">{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="py-16 md:py-24">
      <div class="wrap max-w-3xl">
        <h2>Vanliga frågor</h2>
        <div class="mt-8 divide-y divide-line border-y border-line">
          {faq.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-ink-soft">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-line py-14">
    <div class="wrap">
      <h2 class="font-sans text-base font-semibold">Fungerar ihop med</h2>
      <ul class="mt-4 flex flex-col gap-3 sm:flex-row sm:gap-10">
        {others.map((o) => (
          <li><a href={o.href} class="font-display text-xl font-semibold underline decoration-sun decoration-2 underline-offset-4">{o.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
